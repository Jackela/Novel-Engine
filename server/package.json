{
  "name": "novel-engine-server",
  "productName": "Novel Engine",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "cli": "pnpm run build && node dist/apps/cli/main.js",
    "gate:ssot": "node scripts/qa/check_ssot.mjs",
    "gate:hygiene": "node scripts/qa/check_repo_hygiene.mjs",
    "gate:sizes": "node scripts/qa/check_file_sizes.mjs",
    "gate:migrations": "node scripts/qa/check_migration_channel.mjs",
    "gate:llms-txt": "node scripts/qa/check_llms_txt.mjs",
    "gate:openapi": "vitest run tests/qa/openapi_snapshot.test.ts",
    "openapi:snapshot": "OPENAPI_SNAPSHOT_WRITE=1 vitest run tests/qa/openapi_snapshot.test.ts",
    "db:generate": "drizzle-kit generate",
    "gates": "pnpm run gate:ssot && pnpm run gate:hygiene && pnpm run gate:sizes && pnpm run gate:migrations && pnpm run gate:llms-txt && pnpm run gate:openapi"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "13.0.3",
    "docx": "^9.7.1",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.12.1",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@swc/core": "^1.16.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.13.3",
    "ajv": "^8.12.0",
    "dependency-cruiser": "^18.2.0",
    "drizzle-kit": "0.31.10",
    "typescript": "~7.0.2",
    "vitest": "~4.1.11"
  }
}
