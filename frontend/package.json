{
  "name": "novel-engine-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/check-build-identity.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:ui": "vitest --config vitest.config.ts --ui",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "node ./scripts/run-playwright.mjs test -c playwright.ts.config.ts",
    "test:e2e:smoke": "node ./scripts/run-playwright.mjs test -c playwright.ts.config.ts tests/e2e-ts/studio-ts.spec.ts",
    "test:e2e:ts": "node ./scripts/run-playwright.mjs test -c playwright.ts.config.ts",
    "test:e2e:full-audit": "node ./scripts/run-playwright.mjs test -c playwright.ts.config.ts tests/e2e-ts",
    "test:e2e:headed": "node ./scripts/run-playwright.mjs test -c playwright.ts.config.ts --headed",
    "test:e2e:ui": "node ./scripts/run-playwright.mjs test -c playwright.ts.config.ts --ui",
    "playwright:install": "playwright install",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "type-check": "tsc -p tsconfig.typecheck.json --noEmit",
    "gen:api-types": "pnpm --dir ../tools/api-types exec openapi-typescript ../../server/qa-baselines/openapi.current.json -o ../../frontend/generated/api-types.ts",
    "check:api-types": "node scripts/check-api-types-drift.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.0",
    "react-doctor": "0.9.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
